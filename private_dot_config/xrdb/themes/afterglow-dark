Xft.dark: 1

! NOTE: macro replaced everywhere
! theme specific colors

#define COLOR_FG #d0d0d0
#define COLOR_BG #202020
#define COLOR_BG_ALT #222222

! ── Normal Colors ──
#define COLOR_BLACK   #151515
#define COLOR_RED     #ff5470
#define COLOR_GREEN   #97a470
#define COLOR_YELLOW  #e5b566
#define COLOR_BLUE    #6c99ba
#define COLOR_MAGENTA #b1769e
#define COLOR_CYAN    #7dd5cf
#define COLOR_WHITE   d0d0d0

! ── Bright Colors ──
#define COLOR_BRIGHT_BLACK   #a0a0a0
#define COLOR_BRIGHT_RED     #ff5470
#define COLOR_BRIGHT_GREEN   #97a470
#define COLOR_BRIGHT_YELLOW  #e5b566
#define COLOR_BRIGHT_BLUE    #6c99ba
#define COLOR_BRIGHT_MAGENTA #b1769e
#define COLOR_BRIGHT_CYAN    #7dd5cf
#define COLOR_BRIGHT_WHITE   #f5f5f5

*.foreground:           COLOR_FG
*.background:           COLOR_BG
*.selection_foreground: COLOR_BG
*.selection_background: #808080

! ── Polybar specific ──
*.background_argb:       #aa202020
*.background_alt_argb:   #dd222222
*.background_empty_argb: #00000000
*.border_argb:           #aa000000
*.primary_argb:          #aa97a470

*.cursor:      COLOR_FG
*.cursorColor: COLOR_FG

! ── Formatting Colors ──
*.colorBD: COLOR_YELLOW  !bold
*.colorUL: COLOR_MAGENTA !underline
*.colorIT: COLOR_CYAN    !italic

! ── Normal Colors ──
*.color0:  COLOR_BLACK
*.color1:  COLOR_RED
*.color2:  COLOR_GREEN
*.color3:  COLOR_YELLOW
*.color4:  COLOR_BLUE
*.color5:  COLOR_MAGENTA
*.color6:  COLOR_CYAN
*.color7:  COLOR_WHITE

! ── Bright Colors ──
*.color8:  COLOR_BRIGHT_BLACK
*.color9:  COLOR_BRIGHT_RED
*.color10: COLOR_BRIGHT_GREEN
*.color11: COLOR_BRIGHT_YELLOW
*.color12: COLOR_BRIGHT_BLUE
*.color13: COLOR_BRIGHT_MAGENTA
*.color14: COLOR_BRIGHT_CYAN
*.color15: COLOR_BRIGHT_WHITE
