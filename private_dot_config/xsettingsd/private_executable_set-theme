#!/bin/bash

cd "$( dirname "${BASH_SOURCE[0]}" )" || exit

THEME_PATH="themes/$1"
if [[ ! -f "$THEME_PATH" ]]; then
    THEME_PATH="themes/default"
fi
ln -sf -T "$THEME_PATH" .xsettingsd-light
ln -sf -T "$THEME_PATH-dark" .xsettingsd-dark

echo "$1" > theme

~/.config/rofi/set-theme "$1"
~/.config/xrdb/set-theme "$1"
~/.config/kitty/set-theme "$1"
~/.config/fbterm/set-theme "$1"
