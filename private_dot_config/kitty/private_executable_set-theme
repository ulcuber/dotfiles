#!/bin/bash

cd "$( dirname "${BASH_SOURCE[0]}" )" || exit

THEME_PATH="themes/$1"
if [[ ! -f "$THEME_PATH.conf" ]]; then
    THEME_PATH="themes/default"
fi
ln -sf -T "$THEME_PATH.conf" no-preference-theme.auto.conf
ln -sf -T "$THEME_PATH.conf" light-theme.auto.conf
ln -sf -T "$THEME_PATH-dark.conf" dark-theme.auto.conf
